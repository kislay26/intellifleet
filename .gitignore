# Typical .gitignore for Node + Python projects
# Node
node_modules/
/dist/
/build/
/*.log
npm-debug.log*
.yarnrc
.yarnrc.yml
.yarn/

# dotenv files
.env
.env.local
.env.development
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.dist-info/
*.egg
*.whl
*.log
*.sqlite3

# Virtual env
venv/
.env/
.env.bak/

# IDE/editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

